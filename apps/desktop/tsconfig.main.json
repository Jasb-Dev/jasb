{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.mts", "src/shared/**/*.ts"]
}
