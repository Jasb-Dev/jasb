{
  "name": "@jasb/server",
  "version": "0.1.0",
  "private": true,
  "description": "Thin, log-free proxy in front of the search and decision providers.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/node.ts",
    "start": "node --experimental-strip-types src/node.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@jasb/intent-engine": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
