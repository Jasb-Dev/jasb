# Jasb on one machine.
#
#   jasb.dev       → the landing page, legal pages and live demo  (/srv/jasb/site)
#   app.jasb.dev   → the web client, a single-page app           (/srv/jasb/app)
#   api.jasb.dev   → the Node server on 127.0.0.1:8787
#
# Caddy fetches and renews TLS certificates on its own once DNS points here.
#
# There is deliberately no `log` directive anywhere in this file. Caddy writes
# no access log unless told to, and the privacy policy promises that queries
# and IP addresses are not recorded. Adding one would break that promise.
{
	email dev@jasb.dev
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "interest-cohort=(), browsing-topics=()"
		-Server
	}
}

(static) {
	# Vite fingerprints everything under /assets, so it can be cached forever.
	# HTML must not be, or a deploy is invisible until the cache expires.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	file_server
}

www.jasb.dev {
	redir https://jasb.dev{uri} permanent
}

jasb.dev {
	import common
	root * /srv/jasb/site
	header X-Frame-Options "DENY"
	# `/privacy` and `/privacy.html` both work; the footer links use the latter.
	try_files {path} {path}.html
	import static
	handle_errors {
		rewrite * /index.html
		file_server
	}
}

app.jasb.dev {
	import common
	root * /srv/jasb/app
	header X-Frame-Options "DENY"
	# Client-routed (/bench, …): anything that is not a file is the app.
	try_files {path} /index.html
	import static
}

api.jasb.dev {
	import common
	# CORS is the server's job (JASB_ALLOWED_ORIGINS), not Caddy's: one place
	# to change, and the tests cover it.
	reverse_proxy 127.0.0.1:8787 {
		health_uri /health
		health_interval 30s
	}
}
