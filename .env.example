# Jasb — server configuration.
# Copy to `.env` and fill in only what you have. Everything is optional: with no
# keys at all the server still runs on the free sources (Wikipedia, Marginalia)
# and the engine's keyword fallbacks.

# --- Decision layer -----------------------------------------------------------
# A System One model gives typed decisions with calibrated confidence. Jev's API
# is not open, so the default is a self-hosted open model speaking the same
# `POST /v1/systemone` contract: kev | clm | von | decider | jev
JASB_SYSTEM_ONE_PRESET=
# Where that model is served. Overrides the preset's default URL.
JASB_SYSTEM_ONE_URL=
JASB_SYSTEM_ONE_MODEL=
# Only needed for a hosted endpoint such as Jev.
JASB_SYSTEM_ONE_API_KEY=

# The LLM fallback, also used for BYOK. anthropic | openai | openrouter | gemini | ollama
JASB_LLM_PROVIDER=anthropic
JASB_LLM_API_KEY=
# Default is claude-opus-5. See README → "Choosing a rerank model" for the
# cost-optimised alternative.
JASB_LLM_MODEL=

# --- Search sources -----------------------------------------------------------
# Brave is the recommended general index: independent, ~$0.005/query.
JASB_BRAVE_API_KEY=

# A self-hosted SearxNG instance costs nothing per query. Needs `json` enabled
# in its settings.yml.
JASB_SEARXNG_URL=

# Serper returns Google results for ~$0.001/query. Opt-in only, and never the
# sole general index — see README → "Why Serper is not the default".
JASB_SERPER_API_KEY=

JASB_MARGINALIA_API_KEY=

# --- Server behaviour ---------------------------------------------------------
PORT=8787
# 127.0.0.1 in production, behind Caddy.
JASB_HOST=0.0.0.0
# `*` in dev. In production, the explicit list: https://jasb.dev,chrome-extension://<id>
JASB_ALLOWED_ORIGINS=*
# Jasb Search allowances per month (Kagi-style). URLs, bangs and cache hits are free.
JASB_FREE_MONTHLY_QUOTA=50
JASB_STARTER_MONTHLY_QUOTA=300
JASB_PRO_MONTHLY_QUOTA=2000
# A query reaches the shared cache only after this many distinct devices ask for it.
JASB_SHARED_CACHE_K=3

# --- Public demo --------------------------------------------------------------
# Searches per device per day for visitors without an account.
JASB_DEMO_DAILY_QUOTA=5
# Billable resolutions per day across every visitor. Past it the server drops to
# free sources instead of spending. This is what keeps a busy day bounded.
JASB_DAILY_BUDGET=2000
# Set to true on the public deployment: never accept a stranger's provider key.
JASB_REFUSE_BYOK=false

# --- Billing ------------------------------------------------------------------
# Paddle. Leave empty until the account is verified; checkout stays off until
# the client token, the webhook secret and at least one price id are all set.
JASB_PADDLE_ENV=sandbox
JASB_PADDLE_CLIENT_TOKEN=
JASB_PADDLE_WEBHOOK_SECRET=
# Price ids. Pro may list several, comma-separated (monthly,yearly).
JASB_PADDLE_PRICE_STARTER=
JASB_PADDLE_PRICE_PRO=
JASB_PADDLE_PRICE_SUPPORTER=
# Where the licence store is written. systemd sets STATE_DIRECTORY in production.
JASB_STATE_DIR=.state
